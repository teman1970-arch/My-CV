        // Render Experience Items
        function renderExperience(filter = 'all') {
            const container = document.getElementById('experience-list');
            container.innerHTML = '';

            const filtered = experienceData.filter(item => filter === 'all' || item.type === filter);

            filtered.forEach((item) => {
                const isFullTime = item.type === 'fulltime';
                const badgeClass = isFullTime 
                    ? 'bg-brand-50 text-brand-800 dark:bg-brand-900/40 dark:text-brand-300 border-brand-200 dark:border-brand-800' 
                    : 'bg-amber-50 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 border-amber-200 dark:border-amber-800';
                
                const dotColor = isFullTime ? 'bg-brand-600' : 'bg-amber-500';

                const card = document.createElement('div');
                card.className = 'relative pl-6 sm:pl-8 group transition-all duration-300';
                card.innerHTML = `
                    <!-- Timeline Dot -->
                    <span class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full ${dotColor} ring-4 ring-white dark:ring-slate-800 transition-transform group-hover:scale-125"></span>
                    
