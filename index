                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs sm:text-sm font-medium text-brand-700 dark:text-brand-400 mb-2">
                            <span>${item.role}</span>
                            <span class="text-slate-300 dark:text-slate-600">•</span>
                            <span class="text-slate-500 dark:text-slate-400">${item.mode}</span>
                        </div>
                        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                            ${item.description}
                        </p>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // Filter Handler
        function filterExperience(type) {
            // Update active button styling
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-brand-800', 'dark:text-white', 'shadow-sm');
                btn.classList.add('text-slate-600', 'dark:text-slate-300');
            });

            const activeBtn = document.getElementById(`btn-${type}`);
            activeBtn.classList.remove('text-slate-600', 'dark:text-slate-300');
            activeBtn.classList.add('bg-white', 'dark:bg-slate-800', 'text-brand-800', 'dark:text-white', 'shadow-sm');

            renderExperience(type);
        }

        // Copy to Clipboard using execCommand fallback (iFrame safe)
        function copyText(text, label) {
            const tempInput = document.createElement('textarea');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            try {
                document.execCommand('copy');
                showToast(`${label} copied: ${text}`);
            } catch (err) {
                showToast(`Could not copy ${label}`);
            }
            document.body.removeChild(tempInput);
        }

        // Custom Toast Notification (No alert())
        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-4 py-3 rounded-xl shadow-lg text-sm font-medium flex items-center gap-2.5 transform transition-all duration-300 translate-y-2 opacity-0';
            toast.innerHTML = `<i class="fas fa-check-circle text-emerald-400 dark:text-emerald-600"></i><span>${message}</span>`;
            
            container.appendChild(toast);
            
            // Animate in
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            // Remove after 3 seconds
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Dark Mode Toggle
        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('theme-icon');
            
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                icon.classList.remove('fa-sun');
                icon.classList.add('fa-moon');
            } else {
                html.classList.add('dark');
                icon.classList.remove('fa-moon');
                icon.classList.add('fa-sun');
            }
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', () => {
            renderExperience('all');
        });
    </script>
